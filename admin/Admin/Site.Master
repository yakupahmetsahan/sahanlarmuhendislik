<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="Admin_Site" %>
<!DOCTYPE html>
<html lang="tr">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><asp:ContentPlaceHolder ID="TitleContent" runat="server">Admin</asp:ContentPlaceHolder> | Şahanlar Mühendislik</title>
    <style>
        *{ box-sizing:border-box; }
        body{ font-family:Arial,Helvetica,sans-serif; margin:0; background:#f5f7fb; color:#10192b; }
        .topbar{ background:#10192b; color:#fff; display:flex; align-items:center;
                 justify-content:space-between; padding:0 22px; height:56px; }
        .topbar b{ font-size:1.05rem; }
        .topbar a{ color:#c3cfe3; text-decoration:none; font-size:.85rem; margin-left:18px; }
        .topbar a:hover{ color:#fff; }
        .layout{ display:flex; min-height:calc(100vh - 56px); }
        .sidebar{ width:210px; background:#fff; border-right:1px solid #e3e8f0; padding:20px 0; }
        .sidebar a{ display:block; padding:10px 22px; color:#33405c; text-decoration:none; font-size:.9rem; }
        .sidebar a:hover, .sidebar a.active{ background:#eef2fb; color:#2e6fe0; font-weight:bold; }
        .content{ flex:1; padding:26px 32px; }
        .card{ background:#fff; border:1px solid #e3e8f0; border-radius:8px; padding:22px; margin-bottom:20px; }
        h1.page-title{ font-size:1.35rem; margin:0 0 18px; }
        table.grid{ width:100%; border-collapse:collapse; font-size:.88rem; }
        table.grid th{ text-align:left; background:#f6f8fc; padding:9px 10px; border-bottom:1px solid #e3e8f0; }
        table.grid td{ padding:8px 10px; border-bottom:1px solid #eef1f7; }
        table.grid tr:hover td{ background:#fafbfd; }
        .btn{ display:inline-block; padding:8px 16px; background:#10192b; color:#fff; border:none;
              border-radius:6px; font-size:.85rem; cursor:pointer; text-decoration:none; }
        .btn:hover{ background:#2e6fe0; }
        .btn.secondary{ background:#fff; color:#10192b; border:1px solid #cdd6e6; }
        .btn.danger{ background:#b3261e; }
        .btn.small{ padding:5px 10px; font-size:.78rem; }
        label{ display:block; font-size:.82rem; color:#33405c; margin:14px 0 6px; }
        input[type=text], input[type=number], input[type=file], select, textarea{
            width:100%; padding:9px 11px; border:1px solid #cdd6e6; border-radius:6px; font-size:.9rem;
        }
        textarea{ min-height:90px; font-family:inherit; }
        .filters{ display:flex; gap:10px; margin-bottom:16px; flex-wrap:wrap; align-items:end; }
        .filters > div{ min-width:160px; }
        .msg-ok{ background:#e8f7ee; color:#1b7a3d; padding:10px 14px; border-radius:6px; margin-bottom:16px; font-size:.88rem; }
        .badge{ display:inline-block; padding:2px 8px; border-radius:999px; font-size:.72rem; background:#eef2fb; color:#2e6fe0; }
        .thumb{ width:54px; height:40px; object-fit:cover; border-radius:4px; border:1px solid #e3e8f0; }
    </style>
</head>
<body>
    <form id="formMaster" runat="server">
        <div class="topbar">
            <b>Şahanlar Mühendislik — Yönetim Paneli</b>
            <div>
                <span style="color:#8592a8;font-size:.85rem;">Hoş geldin, <%= Session["AdminDisplayName"] ?? Session["AdminUser"] %></span>
                <a href="~/admin/Logout.aspx" runat="server">Çıkış Yap</a>
            </div>
        </div>
        <div class="layout">
            <div class="sidebar">
                <a href="~/admin/Admin/Default.aspx" runat="server">Panel</a>
                <a href="~/admin/Admin/References.aspx?cat=elektrik" runat="server">Elektrik Referansları</a>
                <a href="~/admin/Admin/References.aspx?cat=enerji" runat="server">Enerji Referansları</a>
                <a href="~/admin/Admin/References.aspx?cat=asansor" runat="server">Asansör Referansları</a>
                <a href="~/admin/Admin/References.aspx?cat=yazilim" runat="server">Yazılım Referansları</a>
                <a href="~/admin/Admin/Images.aspx" runat="server">Kategori Görselleri</a>
                <a href="~/admin/Admin/Team.aspx" runat="server">Ekip</a>
                <a href="~/admin/Admin/Content.aspx" runat="server">Sayfa Metinleri</a>
            </div>
            <div class="content">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>
    </form>
</body>
</html>
