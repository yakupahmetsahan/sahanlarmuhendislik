<?xml version="1.0" encoding="utf-8"?>
<!--
  ÖNEMLİ: connectionString içindeki server/database/uid/pwd bilgilerini
  kendi hostinginizden aldığınız MSSQL bilgileriyle değiştirin.
  İHS panelinizde "Mssql Yönetimi" bölümünden veritabanı adı,
  kullanıcı adı ve şifreyi bulabilirsiniz. Server genellikle
  "localhost" olur, bazı hostinglerde sunucu adı/instance farklı olabilir
  (örn. "localhost\SQLEXPRESS" gibi) — İHS panelinizde tam adres yazar.
-->
<configuration>
  <connectionStrings>
    <add name="SahanlarDb"
         connectionString="Server=94.138.196.30;Database=sahanlarmuhendislik;User Id=sahanlar2026;Password=Sahan200!;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Admin panel oturum süresi (dakika) -->
    <add key="SessionTimeoutMinutes" value="60" />
    <!-- Yüklenen fotoğrafların disk üzerindeki klasörü (proje kökünden itibaren) -->
    <add key="ReferenceUploadPath" value="~/admin/Uploads/references/" />
    <add key="TeamUploadPath" value="~/admin/Uploads/team/" />
    <add key="SiteTilesPath" value="~/assets/img/tiles/" />
    <!-- Yüklenebilecek maksimum dosya boyutu (byte) — varsayılan 5MB -->
    <add key="MaxUploadSizeBytes" value="5242880" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" executionTimeout="120" />
    <customErrors mode="Off" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
