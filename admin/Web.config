<?xml version="1.0" encoding="utf-8"?>
<!--
  ÖNEMLİ: connectionString içindeki server/database/uid/pwd bilgilerini
  kendi hostinginizden aldığınız MySQL bilgileriyle değiştirin.
  İHS panelinizde "MySQL Veritabanları" bölümünden veritabanı adı,
  kullanıcı adı ve şifreyi bulabilirsiniz. Server genellikle
  "localhost" olur, bazı hostinglerde farklı bir adres verilir.
-->
<configuration>
  <connectionStrings>
    <add name="SahanlarDb"
         connectionString="Server=localhost;Database=sahanlar_db;Uid=sahanlar_user;Pwd=BURAYA_SIFRE;charset=utf8;SslMode=none;"
         providerName="MySql.Data.MySqlClient" />
  </connectionStrings>

  <appSettings>
    <!-- Admin panel oturum süresi (dakika) -->
    <add key="SessionTimeoutMinutes" value="60" />
    <!-- Yüklenen fotoğrafların disk üzerindeki klasörü (proje kökünden itibaren) -->
    <add key="ReferenceUploadPath" value="~/Uploads/references/" />
    <add key="TeamUploadPath" value="~/Uploads/team/" />
    <!-- Yüklenebilecek maksimum dosya boyutu (byte) — varsayılan 5MB -->
    <add key="MaxUploadSizeBytes" value="5242880" />
  </appSettings>

  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="8192" executionTimeout="120" />
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" timeout="60" slidingExpiration="true" protection="All" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
    <customErrors mode="Off" />
    <sessionState timeout="60" />
  </system.web>

  <!-- Login.aspx ve genel siteye herkes erişebilsin; sadece /Admin/ altı korumalı -->
  <location path="Login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <location path="Api">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8388608" />
      </requestFiltering>
    </security>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <!--
        MySql.Data (MySQL Connector/NET) NuGet paketini projeye ekleyin:
        Install-Package MySql.Data
        (Visual Studio Package Manager Console üzerinden, veya
        NuGet Package Manager arayüzünden "MySql.Data" arayıp yükleyin)
      -->
      <dependentAssembly>
        <assemblyIdentity name="MySql.Data" publicKeyToken="c5687fc88969c44d" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-99.99.99.99" newVersion="8.0.33.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
